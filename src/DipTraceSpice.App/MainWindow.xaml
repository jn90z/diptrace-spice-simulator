<Window x:Class="DipTraceSpice.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DipTrace SPICE Simulator — PCB Viewer" Height="720" Width="1100" MinWidth="750" MinHeight="500" Background="#14202D" Foreground="#F2F5F8">
<DockPanel>
 <Border DockPanel.Dock="Top" Padding="14" Background="#1F3144"><StackPanel><TextBlock FontSize="23" FontWeight="SemiBold" Text="DipTrace SPICE Simulator"/><TextBlock Foreground="#BACAD8" Text="DipTrace 5.3+ • Read-only geometry preview • Electrical simulation not implemented"/></StackPanel></Border>
 <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12"><Button Content="Open DipTrace XML…" Padding="12,7" Click="OpenButton_Click"/><Button Content="Fit board" Margin="12,0,0,0" Padding="12,7" Click="FitButton_Click"/><CheckBox Foreground="#F2F5F8" Name="TopLayer" Margin="22,0,0,0" VerticalAlignment="Center" Content="Top copper" IsChecked="True" Click="Layer_Click"/><CheckBox Foreground="#F2F5F8" Name="BottomLayer" Margin="14,0,0,0" VerticalAlignment="Center" Content="Bottom copper" IsChecked="True" Click="Layer_Click"/><CheckBox Foreground="#F2F5F8" Name="ComponentsToggle" Margin="14,0,0,0" VerticalAlignment="Center" Content="Component centers" IsChecked="True" Click="Layer_Click"/></StackPanel>
 <TextBlock DockPanel.Dock="Bottom" Name="Status" Margin="12" Foreground="#BACAD8" TextWrapping="Wrap" Text="Open a DipTrace .dipxml file to preview the board outline, traces and component locations."/>
 <Border Margin="12" BorderBrush="#4E657A" BorderThickness="1" Background="#182838" ClipToBounds="True">
  <Canvas Name="BoardCanvas" Background="Transparent" SizeChanged="BoardCanvas_SizeChanged" MouseWheel="BoardCanvas_MouseWheel"/>
 </Border>
</DockPanel></Window>